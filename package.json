{
  "name": "dosound-tracker",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "description": "DOSOUND Tracker",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/zoltraks/dosound-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoltraks/dosound-tracker.git"
  },
  "keywords": [
    "chiptune",
    "tracker",
    "ym2149",
    "atari-st",
    "dosound",
    "music",
    "synthesizer",
    "assembly"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bump": "node scripts/bump-version.mjs && npm run build",
    "retention": "node scripts/retention-sweep.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:8008 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron ."
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "concurrently": "^10.0.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "author": {
    "name": "Filip Golewski",
    "email": "f.golewski@gmail.com",
    "url": "http://home.alyx.pl/"
  },
  "company": "New Generation",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "build": {
    "appId": "com.dosound.tracker",
    "productName": "DOSOUND Tracker",
    "copyright": "Copyright (c) 2025 Zoltar X / New Generation",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "afterAllArtifactBuild": "scripts/afterAllArtifactBuild.cjs",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/media/icon/icon-512.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/media/icon/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "Filip Golewski"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DOSOUND Tracker",
      "uninstallDisplayName": "DOSOUND Tracker",
      "installerIcon": "public/media/icon/icon.ico",
      "uninstallerIcon": "public/media/icon/icon.ico",
      "license": "LICENSE",
      "warningsAsErrors": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "icon": "public/media/icon/icon-512.png"
    }
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "@electron/universal": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.5"
    }
  },
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false
  }
}
